# IA y datos locales. Copiar a .env; nunca usar VITE_ para una clave privada.
VITE_JSON_SERVER_URL=http://127.0.0.1:3000
VERTICE_AI_PROVIDER=n8n
# La credencial DeepSeek está en n8n. Solo para conexión directa opcional:
# VERTICE_AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Backend-only settings for the Admin quote email action.
# Generate a private value with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Put that same generated value in this variable and in n8n Header Auth.
# Header name in n8n: X-Vertice-Webhook-Token. Never commit the real .env.
VERTICE_QUOTE_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook/vertice-quote-email
VERTICE_QUOTE_EMAIL_WEBHOOK_TOKEN=replace-with-a-long-random-secret
VERTICE_PAYMENT_EMAIL_WEBHOOK_URL=http://localhost:5678/webhook/vertice-payment-email
# Payment receipt uses the same Header Auth token by default. Optional override:
# VERTICE_PAYMENT_EMAIL_WEBHOOK_TOKEN=

# Defaults below already match the importable n8n workflows. No VITE_ secrets.
VERTICE_ASSISTANT_GENERAL_URL=http://localhost:5678/webhook/vertice-assistant-general
VERTICE_ASSISTANT_ADMIN_URL=http://localhost:5678/webhook/vertice-assistant-admin
VERTICE_ASSISTANT_QUOTE_URL=http://localhost:5678/webhook/vertice-assistant-quote
# Must be reachable from the n8n runtime for the AI Agent's authorized-tool callback.
# For n8n in Docker Desktop, use http://host.docker.internal:3000/assistants/tools.
VERTICE_ASSISTANT_TOOLS_URL=http://localhost:3000/assistants/tools
VERTICE_RATES_WEBHOOK_URL=http://localhost:5678/webhook/vertice-rates
# PayPal Sandbox only. Get these from a REST app linked to a Sandbox Business account.
# Keep the Secret server-side in .env; never use a VITE_ prefix or commit real values.
VERTICE_PAYPAL_ENV=sandbox
VERTICE_PAYPAL_CLIENT_ID=
VERTICE_PAYPAL_CLIENT_SECRET=
VERTICE_APP_URL=http://localhost:5173
# Optional real workshop copy destination; otherwise the administering account.
# VERTICE_WORKSHOP_EMAIL=
# Only configure electricity once the exact distributor / tariff / kWh block is known.
# Otherwise the academic DEMO rate remains explicitly identified.
# VERTICE_ELECTRICITY_COMPANY=
# VERTICE_ELECTRICITY_TARIFF=
# VERTICE_ELECTRICITY_BLOCK=
# DeepSeek API credential is stored only in n8n's DeepSeek Chat Model node.
